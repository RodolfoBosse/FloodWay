{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), payment=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/rotas/listar/(.*)",
      "destination": "/api/rotas?action=listar"
    },
    {
      "source": "/api/v1/rotas/salvar/(.*)",
      "destination": "/api/rotas?action=salvar"
    },
    {
      "source": "/api/v1/rotas/(.*)/excluir/(.*)",
      "destination": "/api/rotas?action=excluir&id=$1"
    },
    {
      "source": "/api/v1/auth/google/",
      "destination": "/api/auth?action=google"
    },
    {
      "source": "/api/v1/auth/excluir-conta/",
      "destination": "/api/auth?action=excluir-conta"
    },
    {
      "source": "/api/v1/perfil/salvar/",
      "destination": "/api/perfil"
    },
    {
      "source": "/api/v1/cota/(.*)",
      "destination": "/api/cota"
    },
    {
      "source": "/api/cota",
      "destination": "/api/cota"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
